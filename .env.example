# Copia este archivo a .env y completa los valores reales.
# Nunca subas el .env real (ya está en .gitignore).

# Cadena de conexión a MySQL para Prisma.
DATABASE_URL="mysql://usuario:password@localhost:3306/sitecorpac"

# Secreto usado para firmar/verificar el JWT de sesión (src/lib/auth.ts).
# Genera uno largo y aleatorio, distinto en cada entorno.
JWT_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio"

# URL base pública del sitio (usada por sitemap.ts y robots.ts para generar
# URLs absolutas). En local: http://localhost:3000. En producción: la URL real.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
